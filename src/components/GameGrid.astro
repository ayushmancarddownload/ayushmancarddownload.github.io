---
import GameCard from "./GameCard.astro";
import type { Game } from "../lib/types";

interface Props {
  games: Game[];
  title?: string;
  priorityFirst?: boolean;
}
const { games, title, priorityFirst = false } = Astro.props;
---
{title && <h2 class="section-title">{title}</h2>}
<div class="game-grid">
  {games.map((game, i) => (
    <GameCard game={game} priority={priorityFirst && i === 0} />
  ))}
</div>

<script>
  // Preview videos only play on hover/focus (CrazyGames-style) — nothing
  // autoplays just from scrolling a card into view. The clip's src is
  // still only fetched the first time it's actually needed (on hover),
  // so cards nobody hovers never download their preview.
  function attachHoverPlay(root: Document | HTMLElement) {
    root.querySelectorAll<HTMLElement>("[data-game-card]").forEach((card) => {
      const video = card.querySelector<HTMLVideoElement>("video[data-preview-src]");
      if (!video || card.dataset.hoverPlayReady) return;
      card.dataset.hoverPlayReady = "1";

      function play() {
        const src = video!.dataset.previewSrc;
        if (src && !video!.src) video!.src = src;
        video!.play().catch(() => {});
        card.classList.add("is-playing");
      }
      function stop() {
        video!.pause();
        video!.currentTime = 0;
        card.classList.remove("is-playing");
      }

      card.addEventListener("mouseenter", play);
      card.addEventListener("mouseleave", stop);
      card.addEventListener("focus", play);
      card.addEventListener("blur", stop);
    });
  }

  attachHoverPlay(document);
</script>
