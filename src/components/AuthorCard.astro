---
import type { CollectionEntry } from 'astro:content';
import Img from './Img.astro';

export interface Props {
  author: CollectionEntry<'authors'>;
}

const { author } = Astro.props;
---

<a
  href={`/author/${author.slug}/`}
  class="flex flex-col items-center rounded-lg border border-orange-100 bg-white p-6 text-center transition-shadow hover:shadow-md"
>
  <Img src={author.data.avatar} alt={author.data.name} width={96} height={96} sizes="96px" class="h-24 w-24 rounded-full object-cover" />
  <h3 class="mt-4 font-serif text-lg font-semibold text-slate-900">{author.data.name}</h3>
  <p class="text-sm font-medium text-orange-600">{author.data.role}</p>
  <p class="mt-3 line-clamp-3 text-sm text-slate-600">{author.data.bio}</p>
</a>
