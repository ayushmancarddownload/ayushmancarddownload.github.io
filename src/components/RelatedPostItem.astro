---
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const author = await getEntry(post.data.author);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<li class="py-4">
  <h3 class="font-serif text-base font-semibold leading-snug text-slate-900 sm:text-lg">
    <a href={`/blog/${post.slug}/`} class="hover:text-orange-600">{post.data.title}</a>
  </h3>
  <p class="mt-1 text-xs text-slate-500 sm:text-sm">
    {author && (
      <>
        <a href={`/author/${author.slug}/`} class="font-medium text-slate-700 hover:text-orange-600">{author.data.name}</a>
        <span aria-hidden="true"> &middot; </span>
      </>
    )}
    <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
  </p>
</li>
