---
import { Image } from "astro:assets";
import type { Game } from "../lib/types";

interface Props { game: Game }
const { game } = Astro.props;
---
<div class="player-wrap" id="player-wrap" data-title={game.title}>
  <!-- Game loads right away in the background; the dark cover on top of it
       keeps it dim/non-interactive until "Play Now" is pressed. -->
  <iframe
    id="game-iframe"
    src={game.playUrl}
    title={game.title}
    allow="fullscreen; autoplay; gamepad; xr-spatial-tracking"
    allowfullscreen
    loading="eager"
    tabindex="-1"
  ></iframe>

  <button class="player-cover" id="play-cover" aria-label={`Play ${game.title}`}>
    <span class="cover-thumb">
      <Image
        src={game.thumbnail}
        alt={`${game.title} unblocked — play free online`}
        width={220}
        height={140}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </span>
    <span class="play-now-btn">
      <span class="play-now-icon">▶</span>
      Play Now
    </span>
  </button>

  <button class="fullscreen-btn" id="fullscreen-btn" type="button" aria-label={`Play ${game.title} fullscreen`}>
    ⛶ Fullscreen
  </button>
</div>

<script>
  function initPlayer(root: ParentNode = document) {
    const wrap = root.querySelector<HTMLElement>("#player-wrap");
    const cover = root.querySelector<HTMLButtonElement>("#play-cover");
    const fsBtn = root.querySelector<HTMLButtonElement>("#fullscreen-btn");
    const iframe = root.querySelector<HTMLIFrameElement>("#game-iframe");
    if (!wrap || wrap.dataset.playerReady) return;
    wrap.dataset.playerReady = "1";

    function activate() {
      wrap!.classList.add("is-active");
      iframe?.removeAttribute("tabindex");
    }

    cover?.addEventListener("click", activate);

    fsBtn?.addEventListener("click", () => {
      activate();
      if (iframe?.requestFullscreen) {
        iframe.requestFullscreen().catch(() => {});
      } else if ((wrap as any).webkitRequestFullscreen) {
        (wrap as any).webkitRequestFullscreen();
      }
    });
  }
  initPlayer();
</script>

<style>
  .player-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    /* Blocked from receiving clicks/taps until "Play Now" is pressed —
       the cover sits visually on top of it anyway, but this also stops
       accidental interaction while it's dimmed. */
    pointer-events: none;
  }
  .player-wrap.is-active iframe { pointer-events: auto; }

  /* Dark tint over the live game underneath — this is what makes the
     iframe content behind read as "dimmed" instead of fully hidden. */
  .player-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 0 16px;
    /* nudges the thumbnail+button group down from dead-center */
    padding-top: 7%;
    border: none;
    cursor: pointer;
    background: rgba(6, 7, 14, 0.58);
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .player-wrap.is-active .player-cover {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .cover-thumb {
    display: block;
    width: 32%;
    max-width: 220px;
    min-width: 110px;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.75);
    border: 2px solid rgba(255, 255, 255, 0.14);
  }
  .cover-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play-now-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 999px;
    background: var(--gradient);
    color: #0b0c14;
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.01em;
    box-shadow: 0 8px 22px -4px rgba(139, 92, 246, 0.6);
    transition: transform 0.15s ease;
  }
  .play-now-icon { font-size: 0.85em; }
  .player-cover:hover .play-now-btn { transform: scale(1.06); }

  .fullscreen-btn {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    border: none;
    background: rgba(11, 12, 20, 0.72);
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .fullscreen-btn:hover { background: var(--accent); color: #0b0c14; transform: translateY(-1px); }

  @media (max-width: 480px) {
    .cover-thumb { width: 42%; min-width: 96px; }
    .play-now-btn { padding: 10px 22px; font-size: 0.9rem; }
  }
</style>
