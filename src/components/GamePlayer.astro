---
import { Image } from "astro:assets";
import type { Game } from "../lib/types";

interface Props { game: Game }
const { game } = Astro.props;
---
<div class="player-wrap" id="player-wrap" data-play-url={game.playUrl} data-title={game.title}>
  {game.previewVideo && (
    <video
      class="player-bg-video"
      muted
      loop
      autoplay
      playsinline
      preload="none"
      data-preview-src={game.previewVideo}
      aria-hidden="true"
    ></video>
  )}
  <button class="player-cover" id="play-cover" aria-label={`Play ${game.title}`}>
    <Image
      src={game.thumbnail}
      alt={`${game.title} unblocked — play free online`}
      width={960}
      height={540}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <span class="play-btn"><span>▶</span></span>
  </button>
  <button class="fullscreen-btn" id="fullscreen-btn" type="button" aria-label={`Play ${game.title} fullscreen`}>
    ⛶ Fullscreen
  </button>
</div>

<script>
  // Click-to-play: the actual game iframe (often several MB of its own JS/
  // assets) is never requested until the player is clicked — keeps LCP/TBT
  // low on every page this component is used on (home + game pages).
  function initPlayer(root: ParentNode = document) {
    const wrap = root.querySelector<HTMLElement>("#player-wrap");
    const cover = root.querySelector<HTMLButtonElement>("#play-cover");
    const fsBtn = root.querySelector<HTMLButtonElement>("#fullscreen-btn");
    if (!wrap || wrap.dataset.playerReady) return;
    wrap.dataset.playerReady = "1";

    // Background preview video: unlike the "more games" cards (which only
    // load/play their preview on hover), the main player's video starts on
    // its own once the page has loaded — but only AFTER the cover image has
    // already painted, via requestIdleCallback, so it never competes with
    // the page's LCP/TBT.
    const bgVideo = wrap.querySelector<HTMLVideoElement>(".player-bg-video");
    if (bgVideo) {
      const startBgVideo = () => {
        const src = bgVideo.dataset.previewSrc;
        if (src && !bgVideo.src) bgVideo.src = src;
        bgVideo.addEventListener("canplay", () => {
          bgVideo.style.opacity = "1";
          wrap!.classList.add("bg-video-playing");
        }, { once: true });
        bgVideo.play().catch(() => {});
      };
      if ("requestIdleCallback" in window) {
        (window as any).requestIdleCallback(startBgVideo, { timeout: 3000 });
      } else {
        setTimeout(startBgVideo, 1200);
      }
    }

    function ensureIframe(): HTMLIFrameElement {
      let iframe = wrap!.querySelector("iframe");
      if (!iframe) {
        const url = wrap!.dataset.playUrl;
        const title = wrap!.dataset.title ?? "Game";
        iframe = document.createElement("iframe");
        iframe.src = url ?? "";
        iframe.title = title;
        iframe.allow = "fullscreen; autoplay; gamepad; xr-spatial-tracking";
        iframe.setAttribute("allowfullscreen", "true");
        iframe.loading = "eager";
        cover?.remove();
        bgVideo?.remove();
        wrap!.appendChild(iframe);
      }
      return iframe;
    }

    cover?.addEventListener("click", () => ensureIframe());

    fsBtn?.addEventListener("click", () => {
      const iframe = ensureIframe();
      if (iframe.requestFullscreen) {
        iframe.requestFullscreen().catch(() => {});
      } else if ((wrap as any).webkitRequestFullscreen) {
        (wrap as any).webkitRequestFullscreen();
      }
    });
  }
  initPlayer();
</script>

<style>
  .player-bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  /* Once the background video is ready, fade the static thumbnail out so
     the video actually shows through — keep a dark scrim + the play button
     visible on top for contrast/clickability. */
  #player-wrap.bg-video-playing .player-cover img { opacity: 0; transition: opacity 0.4s ease; }
  .player-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.45) 100%);
    pointer-events: none;
  }
  .fullscreen-btn {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    border: none;
    background: rgba(11, 12, 20, 0.72);
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .fullscreen-btn:hover { background: var(--accent); color: #0b0c14; transform: translateY(-1px); }
</style>
