---
import { slugifyTag } from '../utils/slugify';

export interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <div data-pagefind-ignore class="mt-10 flex flex-wrap items-center gap-2">
      <span class="text-sm font-semibold uppercase tracking-wide text-slate-500">Tags</span>
      {tags.map((t) => (
        <a href={`/tag/${slugifyTag(t)}/`} class="pill !min-h-0 !py-1 text-xs">
          #{t}
        </a>
      ))}
    </div>
  )
}
