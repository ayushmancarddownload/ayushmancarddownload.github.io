---
export interface Props {
  url: string; // absolute URL of the post
  title: string;
}
const { url, title } = Astro.props;
const enc = encodeURIComponent;
const whatsapp = `https://wa.me/?text=${enc(`${title} - ${url}`)}`;
const telegram = `https://t.me/share/url?url=${enc(url)}&text=${enc(title)}`;
const btn =
  'inline-flex min-h-[44px] items-center gap-2 rounded-md border border-orange-200 bg-orange-50 px-4 text-sm font-semibold text-orange-700 transition-colors hover:bg-orange-100';
const icon = 'h-4 w-4';
---

<div data-pagefind-ignore class="mt-10">
  <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Share this post</p>
  <div class="flex flex-wrap gap-3">
    <a href={whatsapp} target="_blank" rel="noopener noreferrer" class={btn}>
      <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.7-5.4A8.4 8.4 0 1 1 21 11.5z"></path></svg>
      WhatsApp
    </a>
    <a href={telegram} target="_blank" rel="noopener noreferrer" class={btn}>
      <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13"></path><path d="M22 2l-7 20-4-9-9-4 20-7z"></path></svg>
      Telegram
    </a>
    <button type="button" class={btn} data-copy-link data-url={url}>
      <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path></svg>
      <span data-copy-label>Copy link</span>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url || location.href;
      const label = btn.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        // Old browsers / non-secure context fallback
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch {}
        ta.remove();
      }
      if (label) {
        const old = label.textContent;
        label.textContent = 'Copied!';
        setTimeout(() => (label.textContent = old), 1800);
      }
    });
  });
</script>
