---
import { Image } from "astro:assets";
import type { Game } from "../lib/types";

interface Props {
  game: Game;
  /** Set true only for the very first card above the fold so it can be the LCP element */
  priority?: boolean;
}
const { game, priority = false } = Astro.props;
---
<a href={`/game/${game.id}`} class="game-card" data-game-card aria-label={game.title}>
  <div class="thumb-wrap">
    <div class="thumb-media">
      <Image
        src={game.thumbnail}
        alt={game.title}
        width={300}
        height={225}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
      />
      {game.previewVideo && (
        <video
          muted
          loop
          playsinline
          preload="metadata"
          data-preview-src={game.previewVideo}
          aria-hidden="true"
        ></video>
      )}
    </div>
    <!--
      Title/meta only render on hover/focus (see .card-overlay in global.css).
      Pure CSS opacity/transform transition — no JS, no extra network
      requests, so this costs nothing towards load performance.
    -->
    <div class="card-overlay">
      <p class="card-title">{game.title}</p>
      <p class="card-meta">
        {game.category}
        {game.rating ? ` · ★ ${game.rating.toFixed(1)}` : ""}
      </p>
    </div>
  </div>
</a>
