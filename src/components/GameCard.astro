---
export interface Props {
  game: any;
  big?: boolean;
  hidden?: boolean;
}
const { game, big = false, hidden = false } = Astro.props;
---
<a
  href={`/games/${game.slug}/`}
  class={`game-card ${big ? 'big-card' : 'small-card'} ${hidden ? 'card-hidden' : ''}`}
  style={`background: ${game.bg};`}
  data-search-item
  data-title={game.title}
  data-category={game.category}
>
  {game.badge && <span class="card-badge">{game.badge}</span>}

  <img
    class="card-thumb"
    src={game.thumbnail}
    alt={`${game.title} thumbnail`}
    width="500"
    height="375"
    loading="lazy"
    decoding="async"
  />
  <div class={`card-center-icon ${big ? 'big-icon' : ''}`}>{game.icon}</div>
  <video class="hover-video" loop muted playsinline preload="none" data-src={game.video}></video>

  <button
    class="card-fav-btn"
    data-fav-toggle
    data-slug={game.slug}
    data-title={game.title}
    data-thumbnail={game.thumbnail}
    data-category={game.category}
    aria-label={`Save ${game.title} to favorites`}
    onclick="event.preventDefault();"
  >🤍</button>

  {big ? (
    <div class="card-bottom-info">
      <div>
        <span class="card-title-big">{game.title}</span>
        <span class="card-category">{game.category}</span>
      </div>
      <span class="btn-card-play">PLAY</span>
    </div>
  ) : (
    <div class="card-bottom-info compact">
      <span class="card-title-small">{game.title}</span>
      <span class="btn-card-play-sm">PLAY</span>
    </div>
  )}
</a>
