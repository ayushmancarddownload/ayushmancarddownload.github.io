---
export interface Crumb {
  label: string;
  href?: string;
}

export interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1 text-slate-500">
    <li>
      <a href="/" class="hover:text-orange-600">Home</a>
    </li>
    {
      items.map((item, i) => (
        <>
          <li aria-hidden="true" class="px-1">/</li>
          <li aria-current={i === items.length - 1 ? 'page' : undefined}>
            {item.href && i !== items.length - 1 ? (
              <a href={item.href} class="hover:text-orange-600">
                {item.label}
              </a>
            ) : (
              <span class="font-medium text-slate-700">{item.label}</span>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>
