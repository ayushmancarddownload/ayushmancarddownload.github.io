---
---
<header class="site-header">
  <button
    class="menu-toggle"
    id="menu-toggle"
    aria-label="Toggle menu"
    aria-expanded="false"
    aria-controls="site-sidebar"
  >
    <span></span><span></span><span></span>
  </button>
  <a href="/" class="logo">Moto X3M<span> Unblocked</span></a>
  <form class="search-form" action="/search" method="get" role="search">
    <input
      type="search"
      name="q"
      placeholder="Search games..."
      aria-label="Search games"
      autocomplete="off"
    />
  </form>
</header>
<div class="sidebar-backdrop" id="sidebar-backdrop"></div>

<script>
  // Single menu button, works on BOTH breakpoints:
  // - Mobile (≤860px): sidebar is hidden by default; toggling SHOWS it as an
  //   overlay drawer.
  // - Desktop (>860px): sidebar is visible by default; toggling HIDES it so
  //   the game grid can use the full width.
  // Same "sidebar-toggled" class either way — global.css gives it opposite
  // meaning per breakpoint, so this one script/button handles both.
  const toggle = document.getElementById("menu-toggle");
  const backdrop = document.getElementById("sidebar-backdrop");

  function isMobile() {
    return window.matchMedia("(max-width: 860px)").matches;
  }

  function setToggled(on: boolean) {
    document.body.classList.toggle("sidebar-toggled", on);
    toggle?.setAttribute("aria-expanded", String(isMobile() ? on : !on));
  }

  toggle?.addEventListener("click", () => {
    setToggled(!document.body.classList.contains("sidebar-toggled"));
  });

  backdrop?.addEventListener("click", () => setToggled(false));

  // Auto-close the drawer after tapping a category link — mobile only;
  // on desktop the sidebar should stay put after navigating.
  document.addEventListener("click", (e) => {
    if (isMobile() && e.target instanceof Element && e.target.closest("#site-sidebar a")) {
      setToggled(false);
    }
  });

  // Escape closes the mobile drawer.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isMobile()) setToggled(false);
  });
</script>
