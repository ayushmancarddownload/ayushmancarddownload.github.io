---
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
  lang?: string;
}
const { headings, lang = 'en' } = Astro.props;
// Only h2/h3 — h1 is the post title. Needs at least 3 entries to be worth showing.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const label = lang === 'hi' ? 'इस पोस्ट में क्या है' : 'In this article';
const sections = items.filter((h) => h.depth === 2).length;
const countLabel = lang === 'hi' ? `${sections} भाग` : `${sections} ${sections === 1 ? 'section' : 'sections'}`;
---

{
  items.length >= 3 && (
    <nav aria-label={label} data-pagefind-ignore class="toc not-prose">
      <details open>
        <summary class="toc-summary">
          <span class="toc-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" />
              <circle cx="3.5" cy="6" r="1" /><circle cx="3.5" cy="12" r="1" /><circle cx="3.5" cy="18" r="1" />
            </svg>
          </span>
          <span class="toc-title">{label}</span>
          <span class="toc-count">{countLabel}</span>
          <svg class="toc-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </summary>
        <ol class="toc-list">
          {items.map((h) => (
            <li class={h.depth === 3 ? 'toc-sub' : 'toc-item'}>
              <a href={`#${h.slug}`} data-toc-link={h.slug} class="toc-link">
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

<script>
  // Highlight the section currently being read.
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => links.set(a.dataset.tocLink!, a));
  if (links.size && 'IntersectionObserver' in window) {
    const heads = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            links.forEach((a) => a.classList.remove('toc-active'));
            links.get(e.target.id)?.classList.add('toc-active');
          }
        }
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );
    heads.forEach((h) => io.observe(h));
  }
</script>
