---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with The Orange Desk editorial team — email, contact form, and our location."
>
  <div class="container-page py-8">
    <Breadcrumbs items={[{ label: 'Contact' }]} />
  </div>

  <section class="container-page pb-16">
    <div class="mx-auto max-w-3xl">
      <h1 class="font-serif text-3xl font-semibold text-slate-900 sm:text-4xl">Contact Us</h1>
      <p class="mt-3 text-slate-600">
        Questions about an article, a correction request, or a partnership inquiry — we read every message.
      </p>

      <div class="mt-10 grid gap-10 sm:grid-cols-2">
        <div>
          <h2 class="font-serif text-lg font-semibold text-slate-900">Send a message</h2>
          <form class="mt-4 space-y-4" action="/api/contact" method="POST">
            <div>
              <label for="name" class="block text-sm font-medium text-slate-700">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="mt-1 block w-full min-h-[48px] rounded-md border border-orange-200 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-slate-700">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="mt-1 block w-full min-h-[48px] rounded-md border border-orange-200 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
              />
            </div>
            <div>
              <label for="subject" class="block text-sm font-medium text-slate-700">Subject</label>
              <select
                id="subject"
                name="subject"
                class="mt-1 block w-full min-h-[48px] rounded-md border border-orange-200 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
              >
                <option>General inquiry</option>
                <option>Correction request</option>
                <option>Partnership or advertising</option>
                <option>Other</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-slate-700">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="mt-1 block w-full rounded-md border border-orange-200 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
              ></textarea>
            </div>
            <button type="submit" class="btn-primary w-full sm:w-auto">Send message</button>
          </form>
        </div>

        <div>
          <h2 class="font-serif text-lg font-semibold text-slate-900">Other ways to reach us</h2>
          <dl class="mt-4 space-y-4 text-sm">
            <div>
              <dt class="font-medium text-slate-900">Email</dt>
              <dd class="text-slate-600">hello@postbnao.com</dd>
            </div>
            <div>
              <dt class="font-medium text-slate-900">Editorial corrections</dt>
              <dd class="text-slate-600">corrections@postbnao.com</dd>
            </div>
            <div>
              <dt class="font-medium text-slate-900">Location</dt>
              <dd class="text-slate-600">Mumbai, Maharashtra, India</dd>
            </div>
            <div>
              <dt class="font-medium text-slate-900">Response time</dt>
              <dd class="text-slate-600">We typically reply within 2–3 business days.</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
