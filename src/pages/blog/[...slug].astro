---
import { getCollection, getEntry, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import Img from '../../components/Img.astro';
import RelatedPostItem from '../../components/RelatedPostItem.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import PostNav from '../../components/PostNav.astro';
import PopularPosts from '../../components/PopularPosts.astro';
import TagList from '../../components/TagList.astro';
import Comments from '../../components/Comments.astro';
import { getPublishedPosts, getRelatedPosts, getPopularPosts, getAdjacentPosts } from '../../utils/posts';
import { SITE, absUrl } from '../../config';
import { slugifyCategory } from '../../utils/slugify';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const author = await getEntry(post.data.author);

const words = post.body.split(/\s+/).length;
const readTime = Math.max(1, Math.round(words / 200));

const allPosts = await getPublishedPosts(); // newest first
// Related = shared tags first, then same category / language
const relatedPosts = getRelatedPosts(post, allPosts, 3);
const { newer, older } = getAdjacentPosts(post.slug, allPosts);
const popularPosts = getPopularPosts(
  allPosts.filter((p) => !relatedPosts.some((r) => r.slug === p.slug)),
  4,
  post.slug
);
// Every other post gets a link from this one: whatever isn't already shown above (related / next-prev / trending) goes here.
const shownSlugs = new Set([post.slug, older?.slug, newer?.slug, ...relatedPosts.map((p) => p.slug), ...popularPosts.map((p) => p.slug)]);
const morePosts = allPosts.filter((p) => !shownSlugs.has(p.slug)).slice(0, 12);
const faqHeading = post.data.lang === 'hi' ? 'अक्सर पूछे जाने वाले सवाल' : 'Frequently Asked Questions';

const formattedPubDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const formattedUpdatedDate = post.data.updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const postUrl = absUrl(`/blog/${post.slug}/`);

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: post.data.title,
      description: post.data.description,
      image: [absUrl(post.data.coverImage)],
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      inLanguage: post.data.lang,
      articleSection: post.data.category,
      keywords: post.data.tags.join(', '),
      author: author
        ? {
            '@type': 'Person',
            name: author.data.name,
            url: absUrl(`/author/${author.slug}/`),
          }
        : undefined,
      publisher: {
        '@type': 'Organization',
        name: SITE.name,
        logo: {
          '@type': 'ImageObject',
          url: absUrl(SITE.logo),
        },
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': postUrl,
      },
    },
    ...(post.data.faq.length > 0
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: post.data.faq.map((f) => ({
              '@type': 'Question',
              name: f.q,
              acceptedAnswer: { '@type': 'Answer', text: f.a },
            })),
          },
        ]
      : []),
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: absUrl('/blog/') },
        {
          '@type': 'ListItem',
          position: 3,
          name: post.data.category,
          item: absUrl(`/blog/category/${slugifyCategory(post.data.category)}/`),
        },
        { '@type': 'ListItem', position: 4, name: post.data.title, item: postUrl },
      ],
    },
  ],
};
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.coverImage}
  category={post.data.category}
  canonicalPath={`/blog/${post.slug}/`}
  lang={post.data.lang}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <div slot="header" class="mb-8">
    <span class="pill mb-4 !min-h-0 !py-1 text-xs">{post.data.category}</span>
    <h1 class="font-serif text-3xl font-semibold leading-tight text-slate-900 sm:text-4xl">
      {post.data.title}
    </h1>
    <div data-pagefind-ignore class="mt-4 flex flex-wrap items-center gap-3 text-sm text-slate-500">
      {author && (
        <a href={`/author/${author.slug}/`} class="flex items-center gap-2 hover:text-orange-600">
          <Img src={author.data.avatar} alt={author.data.name} width={36} height={36} sizes="36px" class="h-9 w-9 rounded-full object-cover" />
          <span>
            <span class="block font-medium text-slate-700">{author.data.name}</span>
            <span class="block text-xs text-slate-400">{author.data.role}</span>
          </span>
        </a>
      )}
      <span aria-hidden="true">&middot;</span>
      <time datetime={post.data.pubDate.toISOString()}>Published {formattedPubDate}</time>
      {formattedUpdatedDate && formattedUpdatedDate !== formattedPubDate && (
        <>
          <span aria-hidden="true">&middot;</span>
          <span>Updated {formattedUpdatedDate}</span>
        </>
      )}
      <span aria-hidden="true">&middot;</span>
      <span>{readTime} min read</span>
    </div>
    <Img
      src={post.data.coverImage}
      alt={post.data.coverAlt}
      sizes="(min-width:768px) 768px, 100vw"
      priority
      class="mt-6 aspect-video w-full rounded-lg object-cover"
    />
  </div>

  <TableOfContents slot="before-content" headings={headings} lang={post.data.lang} />

  <Content />

  <div slot="after-content">
    {post.data.faq.length > 0 && (
      <section id="faq" class="mt-12">
        <h2 class="font-serif text-2xl font-semibold text-slate-900">{faqHeading}</h2>
        <div class="mt-4 space-y-3">
          {post.data.faq.map((f) => (
            <div class="rounded-lg border border-orange-100 bg-white p-5">
              <h3 class="font-serif text-lg font-semibold text-slate-900">{f.q}</h3>
              <p class="mt-2 text-slate-600">{f.a}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <TagList tags={post.data.tags} />
    <ShareButtons url={postUrl} title={post.data.title} />

    {author && (
      <div data-pagefind-ignore class="mt-12 flex flex-col gap-4 rounded-lg border border-orange-100 bg-orange-50/50 p-6 sm:flex-row">
        <Img src={author.data.avatar} alt={author.data.name} width={80} height={80} sizes="80px" class="h-20 w-20 shrink-0 rounded-full object-cover" />
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-orange-600">Written by</p>
          <h3 class="mt-1 font-serif text-lg font-semibold text-slate-900">{author.data.name}</h3>
          <p class="text-sm font-medium text-slate-500">{author.data.role}</p>
          <p class="mt-2 text-sm text-slate-600">{author.data.bio}</p>
          <a href={`/author/${author.slug}/`} class="mt-3 inline-block text-sm font-semibold text-orange-600 hover:text-orange-700">
            View full profile &rarr;
          </a>
        </div>
      </div>
    )}

    <PostNav older={older} newer={newer} />

    {relatedPosts.length > 0 && (
      <div data-pagefind-ignore class="mt-12">
        <h2 class="mb-4 font-serif text-xl font-semibold text-slate-900">Related Articles</h2>
        <ul class="divide-y divide-orange-100 rounded-lg border border-orange-100 bg-white px-4 sm:px-5">
          {relatedPosts.map((related) => (
            <RelatedPostItem post={related} />
          ))}
        </ul>
      </div>
    )}

    <PopularPosts posts={popularPosts} />
    <PopularPosts posts={morePosts} heading="More articles" icon="" />
    <Comments />
  </div>
</BlogLayout>
