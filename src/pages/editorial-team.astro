---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const authors = await getCollection('authors');
---

<BaseLayout
  title="Our Editorial Team"
  description="Meet the writers, editors, and fact-checkers behind every article on The Orange Desk, along with their credentials and specialties."
>
  <div class="container-page py-8">
    <Breadcrumbs items={[{ label: 'Editorial Team' }]} />
  </div>

  <section class="container-page pb-16">
    <h1 class="mb-2 font-serif text-3xl font-semibold text-slate-900 sm:text-4xl">Our Editorial Team</h1>
    <p class="mb-10 max-w-2xl text-slate-600">
      Every article published here passes through a named writer and a second reviewer. Here's who's behind the byline.
    </p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {authors.map((author) => (
        <AuthorCard author={author} />
      ))}
    </div>

    <div class="mt-16 rounded-lg border border-orange-100 bg-orange-50/50 p-8">
      <h2 class="font-serif text-xl font-semibold text-slate-900">How we work</h2>
      <p class="mt-3 max-w-2xl text-sm text-slate-600">
        Every draft is fact-checked against primary sources, reviewed by a second editor, and dated so you can see exactly when it was published or last updated. Read our full process on the <a href="/editorial-policy/" class="font-semibold text-orange-600 hover:text-orange-700">editorial policy page</a>.
      </p>
    </div>
  </section>
</BaseLayout>
