---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { absUrl } from '../../config';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({
    params: { id: author.slug },
    props: { author },
  }));
}

const { author } = Astro.props;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const authorPosts = allPosts
  .filter((p) => p.data.author.slug === author.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.data.name,
  jobTitle: author.data.role,
  description: author.data.bio,
  image: absUrl(author.data.avatar),
  url: absUrl(`/author/${author.slug}/`),
  sameAs: [author.data.social.twitter, author.data.social.linkedin].filter(Boolean),
};
---

<BaseLayout
  title={`${author.data.name} — ${author.data.role}`}
  description={author.data.bio.slice(0, 155)}
  ogImage={author.data.avatar}
  canonicalPath={`/author/${author.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} slot="head" />

  <div class="container-page py-8">
    <Breadcrumbs items={[{ label: 'Editorial Team', href: '/editorial-team/' }, { label: author.data.name }]} />
  </div>

  <section class="container-page pb-16">
    <div class="flex flex-col items-start gap-6 rounded-lg border border-orange-100 bg-white p-8 sm:flex-row sm:items-center">
      <img src={author.data.avatar} alt={author.data.name} class="h-28 w-28 rounded-full object-cover" />
      <div>
        <h1 class="font-serif text-3xl font-semibold text-slate-900">{author.data.name}</h1>
        <p class="mt-1 font-medium text-orange-600">{author.data.role}</p>
        <div class="mt-3 flex gap-4 text-sm text-slate-500">
          {author.data.social.twitter && (
            <a href={author.data.social.twitter} class="hover:text-orange-600" rel="noopener noreferrer" target="_blank">Twitter</a>
          )}
          {author.data.social.linkedin && (
            <a href={author.data.social.linkedin} class="hover:text-orange-600" rel="noopener noreferrer" target="_blank">LinkedIn</a>
          )}
          {author.data.social.email && (
            <a href={`mailto:${author.data.social.email}`} class="hover:text-orange-600">Email</a>
          )}
        </div>
      </div>
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="font-serif text-xl font-semibold text-slate-900">About</h2>
        <p class="mt-3 text-slate-600">{author.data.bio}</p>
      </div>
      {author.data.qualifications && author.data.qualifications.length > 0 && (
        <div class="rounded-lg border border-orange-100 bg-orange-50/50 p-6">
          <h2 class="font-serif text-lg font-semibold text-slate-900">Qualifications</h2>
          <ul class="mt-3 space-y-2 text-sm text-slate-600">
            {author.data.qualifications.map((q) => (
              <li class="flex gap-2">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-orange-500" />
                <span>{q}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="mt-12">
      <h2 class="mb-6 font-serif text-2xl font-semibold text-slate-900">
        Articles by {author.data.name}
      </h2>
      {authorPosts.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {authorPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="text-slate-500">No published articles yet.</p>
      )}
    </div>
  </section>
</BaseLayout>
