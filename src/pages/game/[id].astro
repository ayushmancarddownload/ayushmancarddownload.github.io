---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import GameGrid from "../../components/GameGrid.astro";
import { getAllGames, getGameById, getRelatedGames } from "../../lib/gamesApi";

export async function getStaticPaths() {
  const games = await getAllGames();
  return games.map((g) => ({ params: { id: g.id } }));
}

const { id } = Astro.params;
const game = await getGameById(id!);

if (!game) {
  return Astro.redirect("/404");
}

const related = await getRelatedGames(game.id, game.category, 12);
---
<BaseLayout title={`${game.title} — Play Free Online | PlayHub`} description={game.description}>
  <div class="layout">
    <Sidebar activeCategory={game.category} />
    <main class="main">
      <div class="container">
        <div class="game-detail-layout">
          <div>
            <!--
              Click-to-play pattern: the heavy game iframe (often several MB
              of its own JS/assets) is NOT requested on page load. We only
              inject the <iframe src> after the user clicks Play. This is the
              single biggest lever for good LCP/TBT scores on a games site,
              and it's exactly what CrazyGames itself does.
            -->
            <div class="player-wrap" id="player-wrap" data-play-url={game.playUrl} data-title={game.title}>
              <button class="player-cover" id="play-cover" aria-label={`Play ${game.title}`}>
                <Image
                  src={game.thumbnail}
                  alt={game.title}
                  width={960}
                  height={540}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
                <span class="play-btn"><span>▶</span></span>
              </button>
            </div>

            <h1 style="margin:16px 0 4px;">{game.title}</h1>
            <p class="game-meta">
              {game.category}
              {game.rating ? ` · ★ ${game.rating.toFixed(1)}` : ""}
              {game.plays ? ` · ${game.plays.toLocaleString()} plays` : ""}
            </p>
            <p style="color:var(--text-muted);max-width:70ch;">{game.description}</p>
            {game.instructions && (
              <>
                <h2 class="section-title" style="margin-top:16px;">How to play</h2>
                <p style="color:var(--text-muted);">{game.instructions}</p>
              </>
            )}
          </div>

          <aside>
            <h2 class="section-title" style="margin-top:0;">More Games</h2>
            <div class="related-rail">
              {related.slice(0, 6).map((g) => (
                <a href={`/game/${g.id}`} class="game-card" style="display:flex;flex-direction:row;gap:10px;align-items:center;">
                  <div class="thumb-wrap" style="width:96px;flex-shrink:0;">
                    <Image src={g.thumbnail} alt={g.title} width={96} height={72} loading="lazy" decoding="async" />
                  </div>
                  <span class="game-title" style="white-space:normal;">{g.title}</span>
                </a>
              ))}
            </div>
          </aside>
        </div>

        <GameGrid title="You might also like" games={related} />
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  const cover = document.getElementById("play-cover");
  const wrap = document.getElementById("player-wrap");
  cover?.addEventListener("click", () => {
    if (!wrap) return;
    const url = wrap.dataset.playUrl;
    const title = wrap.dataset.title ?? "Game";
    if (!url) return;
    const iframe = document.createElement("iframe");
    iframe.src = url;
    iframe.title = title;
    iframe.allow = "fullscreen; autoplay; gamepad; xr-spatial-tracking";
    iframe.setAttribute("allowfullscreen", "true");
    iframe.loading = "eager";
    cover.remove();
    wrap.appendChild(iframe);
  });
</script>
