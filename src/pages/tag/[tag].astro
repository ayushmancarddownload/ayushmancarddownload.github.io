---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../config';
import { getTagIndex, paginate, pageUrl, tagUrl, MIN_POSTS_FOR_TAG_INDEX } from '../../utils/posts';

export async function getStaticPaths() {
  const tags = await getTagIndex();
  return tags.map((t) => ({ params: { tag: t.slug }, props: { slug: t.slug } }));
}

// Tag page 1. Pages 2..N live in tag/[tag]/page/[page].astro
const { slug } = Astro.props;
const all = await getTagIndex();
const tag = all.find((t) => t.slug === slug)!;
const basePath = tagUrl(slug);
const { items: posts, page, totalPages } = paginate(tag.posts, 1);
const related = all.filter((t) => t.slug !== slug).slice(0, 12);
---

<BaseLayout
  title={`${tag.name} — Articles & Guides`}
  description={`All ${SITE.name} articles tagged "${tag.name}" (${tag.posts.length}), newest first.`}
  canonicalPath={basePath}
  nextPath={totalPages > 1 ? pageUrl(basePath, 2) : undefined}
  noindex={tag.posts.length < MIN_POSTS_FOR_TAG_INDEX}
>
  <div class="container-page py-8">
    <Breadcrumbs items={[{ label: 'Tags', href: '/tags/' }, { label: `#${tag.name}` }]} />
  </div>

  <section class="container-page pb-16">
    <h1 class="mb-2 font-serif text-3xl font-semibold text-slate-900 sm:text-4xl">#{tag.name}</h1>
    <p class="mb-8 max-w-2xl text-slate-600">{tag.posts.length} {tag.posts.length === 1 ? 'article' : 'articles'} tagged "{tag.name}", newest first.</p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, i) => <PostCard post={post} priority={i === 0} />)}
    </div>

    <Pagination currentPage={page} totalPages={totalPages} basePath={basePath} />

    {
      related.length > 0 && (
        <div class="mt-14">
          <h2 class="mb-3 font-serif text-lg font-semibold text-slate-900">Other topics</h2>
          <div class="flex flex-wrap gap-2">
            {related.map((t) => (
              <a href={tagUrl(t.slug)} class="pill !min-h-0 !py-1 text-xs">#{t.name}</a>
            ))}
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>
