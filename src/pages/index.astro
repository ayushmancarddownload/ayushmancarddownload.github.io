---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import PopularPosts from '../components/PopularPosts.astro';
import { SITE, absUrl } from '../config';
import { slugifyCategory } from '../utils/slugify';
import { getHomeListing, paginate, pageUrl, getPopularPosts } from '../utils/posts';

// Page 1 of the home feed. Pages 2..N live in src/pages/page/[page].astro
const { all, featured, rest } = await getHomeListing();
const { items: posts, page, totalPages } = paginate(rest, 1);

const categories = [...new Set(all.map((p) => p.data.category))];
// Trending list only makes sense once there are enough posts to choose from
const trending = all.length >= 4 ? getPopularPosts(all, 5) : [];

const title = `${SITE.name} — ${SITE.tagline}`;
const description =
  'Fact-checked, editor-reviewed guides on personal finance, technology, and everyday decisions — written by named authors with real credentials.';

const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.name,
      description,
      inLanguage: SITE.defaultLang,
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: `${SITE.url}/`,
      logo: { '@type': 'ImageObject', url: absUrl(SITE.logo) },
    },
  ],
};
---

<BaseLayout title={title} description={description} canonicalPath="/" nextPath={totalPages > 1 ? pageUrl('/', 2) : undefined}>
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} slot="head" />

  <section class="border-b border-orange-100 bg-gradient-to-b from-orange-50/60 to-stone-50">
    <div class="container-page flex flex-col items-start gap-6 py-16 sm:py-20">
      <span class="pill">Guides worth trusting</span>
      <h1 class="max-w-2xl font-serif text-4xl font-semibold leading-tight text-slate-900 sm:text-5xl">
        Practical answers to the questions you actually have.
      </h1>
      <p class="max-w-xl text-lg text-slate-600">
        Every article here is written by a named author, reviewed by a second editor, and updated when the facts change. No filler, no guesswork.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/blog/" class="btn-primary">Browse the blog</a>
        <a href="/editorial-team/" class="btn-secondary">Meet the editorial team</a>
      </div>
    </div>
  </section>

  {
    categories.length > 0 && (
      <section class="container-page py-8">
        <div class="flex flex-wrap gap-3">
          {categories.map((cat) => (
            <a href={`/blog/category/${slugifyCategory(cat)}/`} class="pill">
              {cat}
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    featured.length > 0 && (
      <section class="container-page py-8">
        <h2 class="mb-6 font-serif text-2xl font-semibold text-slate-900">Featured</h2>
        <div class="grid gap-6 sm:grid-cols-2">
          {featured.map((post, i) => (
            <PostCard post={post} featured priority={i === 0} />
          ))}
        </div>
      </section>
    )
  }

  {trending.length > 0 && <PopularPosts posts={trending} class="container-page py-8" />}

  <section class="container-page py-8 pb-20">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="font-serif text-2xl font-semibold text-slate-900">Latest Articles</h2>
      <a href="/blog/" class="text-sm font-semibold text-orange-600 hover:text-orange-700">View all &rarr;</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, i) => <PostCard post={post} priority={featured.length === 0 && i === 0} />)}
    </div>
    {posts.length === 0 && featured.length === 0 && (
      <p class="text-slate-500">No articles published yet — check back soon.</p>
    )}

    <Pagination currentPage={page} totalPages={totalPages} basePath="/" />
  </section>
</BaseLayout>
