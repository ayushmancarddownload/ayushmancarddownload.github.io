---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../config';
import { getTagIndex, tagUrl } from '../../utils/posts';

const tags = await getTagIndex();
---

<BaseLayout
  title="All Tags"
  description={`Browse every topic tag on ${SITE.name} and jump straight to the articles you need.`}
  canonicalPath="/tags/"
>
  <div class="container-page py-8">
    <Breadcrumbs items={[{ label: 'Tags' }]} />
  </div>

  <section class="container-page pb-16">
    <h1 class="mb-2 font-serif text-3xl font-semibold text-slate-900 sm:text-4xl">All Tags</h1>
    <p class="mb-8 max-w-2xl text-slate-600">Pick a topic to see every article about it.</p>

    {
      tags.length > 0 ? (
        <div class="flex flex-wrap gap-3">
          {tags.map((t) => (
            <a href={tagUrl(t.slug)} class="pill">
              #{t.name} <span class="ml-2 text-xs text-slate-500">{t.posts.length}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-slate-500">No tags yet.</p>
      )
    }
  </section>
</BaseLayout>
