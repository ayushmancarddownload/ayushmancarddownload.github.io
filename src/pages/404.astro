---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist or has moved." noindex>
  <section class="container-page py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-orange-600">Error 404</p>
    <h1 class="mt-3 font-serif text-4xl font-semibold text-slate-900">Page not found</h1>
    <p class="mx-auto mt-4 max-w-md text-slate-600">
      The page you're looking for doesn't exist or has moved. Try the latest articles instead.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn-primary">Go to homepage</a>
      <a href="/blog/" class="btn-secondary">Browse the blog</a>
    </div>
  </section>
</BaseLayout>
