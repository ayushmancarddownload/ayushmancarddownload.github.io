---
import '../styles/global.css';
import { SITE, absUrl } from '../config';
// Self-hosted variable fonts (no Google Fonts request, no extra DNS/TLS round trips).
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/lora/wght.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import loraLatin from '@fontsource-variable/lora/files/lora-latin-wght-normal.woff2?url';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalPath?: string;
  lang?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  prevPath?: string;
  nextPath?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  ogImage = SITE.defaultOgImage,
  canonicalPath,
  lang = SITE.defaultLang,
  ogType = 'website',
  noindex = false,
  prevPath,
  nextPath,
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteName = SITE.name;
// Canonical always points at the production domain, never a preview/github.io URL.
const canonicalURL = absUrl(canonicalPath ?? Astro.url.pathname);
const ogImageURL = absUrl(ogImage);
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const ogLocale = lang === 'hi' ? 'hi_IN' : 'en_IN';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/editorial-team/', label: 'Editorial Team' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {prevPath && <link rel="prev" href={absUrl(prevPath)} />}
    {nextPath && <link rel="next" href={absUrl(nextPath)} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ea580c" />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={loraLatin} crossorigin />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-stone-50 font-sans text-slate-700">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-orange-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-orange-100 bg-stone-50/90 backdrop-blur">
      <div class="container-page flex h-16 items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-slate-900">
          <span class="flex h-9 w-9 items-center justify-center rounded-md bg-orange-600 font-serif text-lg font-semibold text-white">
            OD
          </span>
          <span class="font-serif text-xl font-semibold">{siteName}</span>
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-md px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-orange-100 hover:text-orange-700"
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <button
          id="menu-toggle"
          type="button"
          class="flex h-12 w-12 items-center justify-center rounded-md text-slate-700 hover:bg-orange-100 md:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-drawer"
        >
          <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Mobile drawer -->
    <div id="drawer-overlay" class="fixed inset-0 z-30 hidden bg-slate-900/40 md:hidden"></div>
    <aside
      id="mobile-drawer"
      class="fixed right-0 top-0 z-40 h-full w-72 max-w-[85%] translate-x-full transform bg-stone-50 shadow-xl transition-transform duration-300 ease-in-out md:hidden"
      aria-hidden="true"
    >
      <div class="flex h-16 items-center justify-between border-b border-orange-100 px-4">
        <span class="font-serif text-lg font-semibold text-slate-900">Menu</span>
        <button
          id="drawer-close"
          type="button"
          class="flex h-12 w-12 items-center justify-center rounded-md text-slate-700 hover:bg-orange-100"
          aria-label="Close menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <nav class="flex flex-col gap-1 p-4" aria-label="Mobile">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="flex min-h-[48px] items-center rounded-md px-3 text-base font-medium text-slate-700 hover:bg-orange-100 hover:text-orange-700"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </aside>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-orange-100 bg-white">
      <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <a href="/" class="flex items-center gap-2 text-slate-900">
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-orange-600 font-serif text-sm font-semibold text-white">OD</span>
            <span class="font-serif text-lg font-semibold">{siteName}</span>
          </a>
          <p class="mt-3 text-sm text-slate-500">
            Practical, fact-checked guides on money, technology, and everyday decisions — written by named editors and reviewed before publishing.
          </p>
        </div>

        <div>
          <h3 class="font-serif text-sm font-semibold uppercase tracking-wide text-slate-900">Explore</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/blog/" class="text-slate-600 hover:text-orange-600">Blog Archive</a></li>
            <li><a href="/editorial-team/" class="text-slate-600 hover:text-orange-600">Editorial Team</a></li>
            <li><a href="/about/" class="text-slate-600 hover:text-orange-600">About Us</a></li>
            <li><a href="/contact/" class="text-slate-600 hover:text-orange-600">Contact</a></li>
          </ul>
        </div>

        <div>
          <h3 class="font-serif text-sm font-semibold uppercase tracking-wide text-slate-900">Policies</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/editorial-policy/" class="text-slate-600 hover:text-orange-600">Editorial Policy</a></li>
            <li><a href="/privacy-policy/" class="text-slate-600 hover:text-orange-600">Privacy Policy</a></li>
            <li><a href="/terms/" class="text-slate-600 hover:text-orange-600">Terms of Service</a></li>
            <li><a href="/disclaimer/" class="text-slate-600 hover:text-orange-600">Disclaimer</a></li>
          </ul>
        </div>

        <div>
          <h3 class="font-serif text-sm font-semibold uppercase tracking-wide text-slate-900">Contact</h3>
          <ul class="mt-3 space-y-2 text-sm text-slate-600">
            <li>{SITE.email}</li>
            <li>Mumbai, Maharashtra, India</li>
          </ul>
        </div>
      </div>
      <div class="border-t border-orange-100 py-6">
        <p class="container-page text-center text-xs text-slate-500">
          &copy; {new Date().getFullYear()} {siteName}. All rights reserved.
        </p>
      </div>
    </footer>

    <script>
      const menuToggle = document.getElementById('menu-toggle');
      const drawer = document.getElementById('mobile-drawer');
      const overlay = document.getElementById('drawer-overlay');
      const drawerClose = document.getElementById('drawer-close');
      const iconOpen = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');

      function openDrawer() {
        drawer?.classList.remove('translate-x-full');
        drawer?.setAttribute('aria-hidden', 'false');
        overlay?.classList.remove('hidden');
        menuToggle?.setAttribute('aria-expanded', 'true');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
      }

      function closeDrawer() {
        drawer?.classList.add('translate-x-full');
        drawer?.setAttribute('aria-hidden', 'true');
        overlay?.classList.add('hidden');
        menuToggle?.setAttribute('aria-expanded', 'false');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }

      menuToggle?.addEventListener('click', () => {
        const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
        isOpen ? closeDrawer() : openDrawer();
      });
      drawerClose?.addEventListener('click', closeDrawer);
      overlay?.addEventListener('click', closeDrawer);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDrawer();
      });
    </script>
    <button
      id="back-to-top"
      type="button"
      aria-label="Back to top"
      title="Back to top"
      class="back-to-top"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5" />
        <path d="M5 12l7-7 7 7" />
      </svg>
    </button>
    <script>
      const btn = document.getElementById('back-to-top');
      if (btn) {
        let ticking = false;
        const update = () => {
          btn.classList.toggle('is-visible', window.scrollY > 400);
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true }
        );
        btn.addEventListener('click', () => {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
        update();
      }
    </script>
  </body>
</html>
