---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { slugifyCategory } from '../utils/slugify';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  category: string;
  canonicalPath?: string;
  lang?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const { title, description, ogImage, category, canonicalPath, lang, publishedTime, modifiedTime } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  canonicalPath={canonicalPath}
  lang={lang}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
>
  <slot name="head" slot="head" />

  <div class="container-page py-8">
    <Breadcrumbs items={[{ label: 'Blog', href: '/blog/' }, { label: category, href: `/blog/category/${slugifyCategory(category)}/` }, { label: title }]} />
  </div>

  <article class="container-page pb-16">
    <div class="mx-auto max-w-3xl">
      <slot name="header" />
      <div class="prose prose-orange lg:prose-lg mx-auto max-w-none">
        <slot />
      </div>
      <slot name="after-content" />
    </div>
  </article>
</BaseLayout>

<script>
  // Auto-fit: shrink the font of each code/ASCII block until it fits the post width.
  // Runs on load, when fonts finish loading, and on resize/rotate.
  const MIN_FONT = 7; // px; below this we fall back to horizontal scroll

  function fitBlock(pre: HTMLElement) {
    pre.style.fontSize = '';
    const cs = getComputedStyle(pre);
    const base = parseFloat(cs.fontSize);
    const padX = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
    let size = base;
    for (let i = 0; i < 4; i++) {
      const avail = pre.clientWidth - padX;
      const need = pre.scrollWidth - padX;
      if (need <= avail + 0.5 || size <= MIN_FONT) break;
      size = Math.max(MIN_FONT, size * (avail / need) * 0.995);
      pre.style.fontSize = size + 'px';
    }
  }

  function fitAll() {
    document.querySelectorAll<HTMLElement>('.prose pre').forEach(fitBlock);
  }

  let t: number | undefined;
  const schedule = () => {
    clearTimeout(t);
    t = window.setTimeout(fitAll, 120);
  };

  fitAll();
  window.addEventListener('load', fitAll);
  window.addEventListener('resize', schedule);
  window.addEventListener('orientationchange', schedule);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitAll);
</script>
